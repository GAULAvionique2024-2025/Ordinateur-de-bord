#include "GAUL_Drivers/Low_Level/PWM_driver.h"

void TIM_Enable(TIM_TypeDef *TIMx) {
	if (TIMx == TIM1) {
		RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;
	} else if (TIMx == TIM8) {
		RCC->APB2ENR |= RCC_APB2ENR_TIM8EN;
	} else return;
}

void PWM_InitPeriph(TIM_TypeDef *TIMx, uint16_t prescaler, uint16_t arr, uint16_t canal) {
	if (TIMx != TIM1 && TIMx != TIM8) return;					// Protection
	if ((TIMx == TIM1 && (canal != 1 && canal != 2)) ||
		(TIMx == TIM8 && (canal != 3 && canal != 4))) return;	// Protection
    TIMx->PSC = prescaler;                       				// Prescaler
    TIMx->ARR = arr;                        					// Auto-reload

    switch (canal) {
		case 1: // TIM1 CH1
			TIMx->CCMR1 &= ~TIM_CCMR1_OC1M;
			TIMx->CCMR1 |= (6 << TIM_CCMR1_OC1M_Pos);  			// PWM mode 1
			TIMx->CCMR1 |= TIM_CCMR1_OC1PE;            			// Output preload
			TIMx->CCER  |= TIM_CCER_CC1E;              			// Enable output
			TIMx->CCR1   = 0;
			break;
		case 2: // TIM1 CH2
			TIMx->CCMR1 &= ~TIM_CCMR1_OC2M;
			TIMx->CCMR1 |= (6 << TIM_CCMR1_OC2M_Pos);
			TIMx->CCMR1 |= TIM_CCMR1_OC2PE;
			TIMx->CCER  |= TIM_CCER_CC2E;
			TIMx->CCR2   = 0;
			break;
		case 3: // TIM8 CH3
			TIMx->CCMR2 &= ~TIM_CCMR2_OC3M;
			TIMx->CCMR2 |= (6 << TIM_CCMR2_OC3M_Pos);
			TIMx->CCMR2 |= TIM_CCMR2_OC3PE;
			TIMx->CCER  |= TIM_CCER_CC3E;
			TIMx->CCR3   = 0;
			break;
		case 4: // TIM8 CH4
			TIMx->CCMR2 &= ~TIM_CCMR2_OC4M;
			TIMx->CCMR2 |= (6 << TIM_CCMR2_OC4M_Pos);
			TIMx->CCMR2 |= TIM_CCMR2_OC4PE;
			TIMx->CCER  |= TIM_CCER_CC4E;
			TIMx->CCR4   = 0;
			break;
	}

    TIMx->CR1 |= TIM_CR1_CEN;	// Timer start
}

void PWM_SetDutyCycle(TIM_TypeDef *TIMx, uint16_t duty) {
	if (duty > 100) duty = 100; 		// Protection
	uint32_t arr = TIMx->ARR + 1;
	TIMx->CCR1 = (duty * arr) / 100; 	// CCR (duty cycle)
}

void PWM_SetFrequency(TIM_TypeDef *TIMx, uint32_t freq) {
	if (freq == 0) return;  												// Protection
	uint32_t prescaler = TIMx->PSC + 1;										// Prescaler
    uint32_t arr = (SystemCoreClock / (freq * prescaler)) - 1;  	// ARR
    TIMx->ARR = newArr;
}
