#ifndef INC_GAUL_DRIVERS_COMPONENTS_MS5803_H_
#define INC_GAUL_DRIVERS_COMPONENTS_MS5803_H_

#include <GAUL_Drivers/Low_Level/GPIO_driver.h>
#include "GAUL_Drivers/Low_Level/SPI_driver.h"
#include "stm32f4xx.h"

#include <stdint.h>
#include <stdio.h>
#include <math.h>

#define MS5803_RESET     	0x1E
#define MS5803_CONVERT_D1 	0x44 //OSR->1024
#define MS5803_CONVERT_D2	0x54 //OSR->1024
#define MS5803_ADC_READ  	0x00
#define MS5803_PROM_READ	0xA0

#define HPA_SEA_LEVEL 1013.25f
#define ALPHA_FILTER_FACTOR 0.1f
#define T0 288.15f	// Standard temperature at sea level in Kelvin
#define L 0.0065f	// Temperature lapse rate in K/m
#define R 287.05f	// Specific gas constant for dry air in J/(kg·K)
#define G 9.80665f	// Gravitational acceleration in m/s^2

typedef struct {
    SPI_TypeDef 	*SPIx;
    GPIO_TypeDef 	*cs_port;
    uint8_t 		cs_pin;

    uint16_t 		calibration_values[8];

    float 			pressure_Pa;
    float 			pressure_kPa;
    float			pressure_ref;

    float 			altitude_m;
    float 			altitude_filtered_m;

    float 			temp_C;
} MS5803;

int8_t MS5803_Init(MS5803 *dev, float pressureRef);
void MS5803_ReadTemperaturePressure(MS5803 *dev);
void MS5803_Write(MS5803 *dev, uint8_t address, uint8_t value);
void MS5803_Read(MS5803 *dev, uint8_t addresse, uint8_t *rxData[], uint8_t size);


#endif /* INC_GAUL_DRIVERS_COMPONENTS_MS5803_H_ */
