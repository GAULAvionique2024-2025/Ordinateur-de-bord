#ifndef INC_GAUL_DRIVERS_LOW_LEVEL_SPI_DRIVER_H_
#define INC_GAUL_DRIVERS_LOW_LEVEL_SPI_DRIVER_H_

#include "stm32f4xx.h"


#define SPI_BAUDRATE_DIV2    (0b000 << 3) // 50 MHz
