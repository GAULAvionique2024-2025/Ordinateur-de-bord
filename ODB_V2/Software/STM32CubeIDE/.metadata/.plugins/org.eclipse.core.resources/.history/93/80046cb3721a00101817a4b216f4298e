#include "GAUL_Drivers/Low_Level/PWM_driver.h"

void TIM_Enable(TIM_TypeDef *TIMx) {
	if (TIMx == TIM1) {
		RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;
	} else if (TIMx == TIM8) {
		RCC->APB2ENR |= RCC_APB2ENR_TIM8EN;
	} else return;
}

void PWM_InitPeriph(TIM_TypeDef *TIMx, uint16_t prescaler, uint16_t arr, uint16_t canal) {
	if (TIMx != TIM1 && TIMx != TIM8) return;				// Protection
    TIMx->PSC = prescaler;                       			// Prescaler
    TIMx->ARR = arr;                        				// Auto-reload
    TIMx->CCMR1 |= TIM_CCMR1_OC1M_1 | TIM_CCMR1_OC1M_2;     // Canal
    TIMx->CCER |= TIM_CCER_CC1E;          					// Enable canal
    TIMx->CR1 |= TIM_CR1_CEN;             					// Timer start
}

void PWM_SetDutyCycle(TIM_TypeDef *TIMx, uint16_t duty) {
	TIMx->CCR1 = (duty * (TIMx->ARR + 1)) / 100; // CCR (duty cycle)
}

void PWM_SetFrequency(TIM_TypeDef *TIMx, uint32_t freq) {
	//TODO: check SystemCoreClock | oscillator
    uint32_t timeClock = SystemCoreClock / 2;  // Fr�quence du Timer (APB1)
    uint32_t newArr = (timer_clock / (freq * (TIMx->PSC + 1))) - 1;  // ARR
    TIMx->ARR = newArr;
}
