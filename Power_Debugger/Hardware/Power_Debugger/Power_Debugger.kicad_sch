	(text "=== Use case limit ===\n10V x 2A = 20W\nEfficiency Boost 90% = 1.1 x 20 = 22W\nIf Battery is low (2.7V): 22 / 2.7 = 8.148A\nFS8205A Rds(on) = 27mOhm at 4.5V with 150mV voltage drop protection (54mOhm)\nFS8205A Rds(on) = 37mOhm at 2.5V with 150mV voltage drop protection (74mOhm)\nRmax = 150m / 8.148 = 18.5mOhm\n74m / 18.5m > 4 FS8205A\n\n5x FS8205A = 74m / 5 = 14.8mOhm\n14.8m x 8.148 = 120.59 < 150"
		(exclude_from_sim no)
		(at 191.516 152.908 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9c381d56-2c08-48e5-9f85-4deebff23e2f")
	)
