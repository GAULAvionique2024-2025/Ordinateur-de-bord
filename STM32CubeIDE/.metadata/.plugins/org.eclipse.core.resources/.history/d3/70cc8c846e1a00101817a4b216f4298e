#include "pwm.h"

void PWM_Init(void) {

    RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;   // Activer horloge Timer 2
    TIM2->PSC = 2;                       // Prescaler pour une fréquence de base
    TIM2->ARR = 499;                      // Auto-reload pour définir la période du PWM
    TIM2->CCMR1 |= TIM_CCMR1_OC1M_1 | TIM_CCMR1_OC1M_2;   // Mode PWM 1 sur le canal 1
    TIM2->CCER |= TIM_CCER_CC1E;          // Activer la sortie sur le canal 1
    TIM2->CR1 |= TIM_CR1_CEN;             // Démarrer le Timer 2
}

void PWM_SetDutyCycle(uint16_t duty) {

    TIM2->CCR1 = (duty * (TIM2->ARR + 1)) / 100; // Calcul du CCR pour ajuster le duty cycle
}

void PWM_SetFrequency(uint32_t freq) {

    uint32_t timer_clock = SystemCoreClock / 2;  // Fréquence du Timer (APB1)
    uint32_t newArr = (timer_clock / (freq * (TIM2->PSC + 1))) - 1;  // Calcul du ARR
    TIM2->ARR = newArr;
}
