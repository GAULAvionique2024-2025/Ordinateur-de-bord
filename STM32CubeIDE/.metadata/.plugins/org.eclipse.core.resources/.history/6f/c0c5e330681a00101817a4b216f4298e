#include "GAUL_Drivers/Communications/USART_driver.h"
#include "GAUL_Drivers/Communications/GPIO_driver.h"


void USART_Enable(USART_TypeDef *USARTx) {
	if (USARTx == USART1) {
		RCC->APB2ENR |= RCC_APB2ENR_USART1EN;		// Enable USART1 clock
		GPIO_Initialisation(GPIOA, 9, ALT, AF7); 	// TX (A9)
		GPIO_Initialisation(GPIOA, 10, ALT, AF7); 	// RX (A10)
	} else if (USARTx == USART2) {
		RCC->APB1ENR |= RCC_APB1ENR_USART2EN; 		// Enable USART2 clock
		GPIO_Initialisation(GPIOD, 5, ALT, AF7); 	// TX (D5)
		GPIO_Initialisation(GPIOD, 6, ALT, AF7); 	// RX (D6)
	} else if (USARTx == USART3) {
		RCC->APB1ENR |= RCC_APB1ENR_USART3EN; 		// Enable USART3 clock
		GPIO_Initialisation(GPIOB, 10, ALT, AF7); 	// TX (B10)
		GPIO_Initialisation(GPIOB, 11, ALT, AF7); 	// RX (B11)
	} else if (USARTx == USART6) {
		RCC->APB2ENR |= RCC_APB2ENR_USART6EN; 		// Enable USART6 clock
		GPIO_Initialisation(GPIOC, 6, ALT, AF8); 	// TX (C6)
		GPIO_Initialisation(GPIOC, 7, ALT, AF8); 	// RX (C7)
	} else return;
}

void USART_Initialisation(USART_TypeDef *USARTx, unsigned long baudrate) {
	if(USARTx != USART3) return;
	USART_Enable(USARTx); // Protection
	USARTx->BRR = baudrate; 			// Baudrate
	USARTx->CR1 &= ~USART_CR1_M; 		// 8 bits
	USARTx->CR1 &= ~USART_CR1_PCE; 		// Disable parity
	USARTx->CR2 &= ~USART_CR2_STOP; 	// 1 stop bit
	USARTx->CR1 |= USART_CR1_RE; 		// RX Enable
	USARTx->CR1 |= USART_CR1_TE; 		// TX Enable
	USARTx->CR1 |= USART_CR1_UE; 		// USART Enable
}

//TODO: timeout maybe not necessary + add interrupt
int8_t USART_TX(USART_TypeDef *USARTx, uint8_t *data, size_t size) {
    uint32_t timeout;
	while(size--) {
		timeout = TIMEOUT;
		while (!(USARTx->SR & USART_SR_TXE)) {
			if (--timeout == 0) {
				return -1;
			}
		}
		USARTx->DR = *data++;
	}

	timeout = TIMEOUT;
	while (!(USARTx->SR & USART_SR_TC)) {
		if (--timeout == 0) {
			return -1;
		}
	}
	return 0;
}

//TODO: add interrupt + circular buffer
int8_t USART_RX(USART_TypeDef *USARTx, uint8_t *data, size_t size) {
	uint32_t timeout;
	while(size--) {
		timeout = TIMEOUT;
		while (!(USARTx->SR & USART_SR_RXNE)) {
			if (--timeout == 0) {
				return -1;
			}
		}
		*data++ = (uint8_t)USARTx->DR;
	}
	return 0;
}
