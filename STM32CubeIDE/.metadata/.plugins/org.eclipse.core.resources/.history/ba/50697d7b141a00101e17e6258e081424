#include "GAUL_Drivers/Communications/GPIO_driver.h"

void Enable_GPIO_Clock(GPIO_TypeDef *port) {
    if (port == GPIOA) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN; // Activer PORT A
    } else if (port == GPIOB) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN; // Activer PORT B
    } else if (port == GPIOC) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN; // Activer PORT C
    } else if (port == GPIOD) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIODEN; // Activer PORT D
    } else if (port == GPIOE) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOEEN; // Activer PORT E
    } else if (port == GPIOF) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOFEN; // Activer PORT F
    } else if (port == GPIOG) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOGEN; // Activer PORT G
    } else if (port == GPIOH) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOHEN; // Activer PORT H
    }
}

void Init_GPIO(GPIO_TypeDef *port, unsigned short pin, unsigned short dir, unsigned short opt) {
    Enable_GPIO_Clock(port);

}

int Read_GPIO(GPIO_TypeDef *port, unsigned short pin) {
    return (port->IDR & (1 << pin)) >> pin;
}

void Write_GPIO(GPIO_TypeDef *port, unsigned short pin, unsigned short state) {
    if (state) {
        port->ODR |= (1 << pin);
    } else {
        port->ODR &= ~(1 << pin);
    }
}

void Toggle_GPIO(GPIO_TypeDef *port, unsigned short pin) {
    port->ODR ^= (1 << pin);
}
