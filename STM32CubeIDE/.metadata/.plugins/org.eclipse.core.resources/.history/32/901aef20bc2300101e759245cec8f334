#include "GAUL_Drivers/Components/MS5803.h"


// Utils
static void CS_Select(MS5803 *dev) {
    GPIO_WritePin(dev->cs_port, dev->cs_pin, LOW);
}

static void CS_Deselect(MS5803 *dev) {
    GPIO_WritePin(dev->cs_port, dev->cs_pin, HIGH);
}

static void MS5803_SendCommand(MS5803 *dev, uint8_t MS5803) {
    CS_Select(dev);
    SPI_TX(dev->SPIx, &MS5803, 1);
    CS_Deselect(dev);
}

static uint32_t MS5803_ReadADC(MS5803 *dev) {
    uint8_t MS5803 = MS5803_ADC_READ;
    uint8_t rx_buf[3] = {0};

    CS_Select(dev);
    SPI_TX(dev->SPIx, &MS5803, 1);
    SPI_RX(dev->SPIx, rx_buf, 3);
    CS_Deselect(dev);

    return (rx_buf[0] << 16) | (rx_buf[1] << 8) | rx_buf[2];
}

static uint16_t MS5803_ReadPROM(MS5803 *dev, uint8_t coef) {
    uint8_t MS5803 = MS5803_PROM_READ + (coef * 2);
    uint8_t rx_buf[2] = {0};

    CS_Select(dev);
    SPI_TX(dev->SPIx, &MS5803, 1);
    SPI_RX(dev->SPIx, rx_buf, 2);
    CS_Deselect(dev);

    return (rx_buf[0] << 8) | rx_buf[1];
}

int8_t MS5803_Init(MS5803 *dev) {
    MS5803_SendCommand(dev, MS5803_RESET);
    for (uint8_t i = 0; i < 8; i++) {
        dev->calibration_values[i] = MS5803_ReadPROM(dev, i);
    }
    return 0; // OK
}

void MS5803_ReadTemperaturePressure(MS5803 *dev) {
    uint32_t D1, D2;
    int32_t dT, TEMP;
    int64_t OFF, SENS;
    int32_t T2 = 0;
    int64_t OFF2 = 0, SENS2 = 0;

    // Convert D1 (Pression)
    MS5803_SendCommand(dev, MS5803_CONVERT_D1);
    D1 = MS5803_ReadADC(dev);

    // Convert D2 (Temp)
    MS5803_SendCommand(ms5803, MS5803_CONVERT_D2);
    D2 = MS5803_ReadADC(ms5803);

    // Calculs selon datasheet
    dT = (int32_t)D2 - ((int32_t)ms5803->C[5] << 8);
    TEMP = 2000 + ((int64_t)dT * ms5803->C[6]) / (1 << 23);

    OFF = ((int64_t)ms5803->C[2] << 16) + (((int64_t)ms5803->C[4] * dT) / (1 << 7));
    SENS = ((int64_t)ms5803->C[1] << 15) + (((int64_t)ms5803->C[3] * dT) / (1 << 8));

    // Compensation deuxième ordre
    if (TEMP < 2000) {
        T2 = (dT * dT) >> 31;
        OFF2 = 5 * ((TEMP - 2000) * (TEMP - 2000)) >> 1;
        SENS2 = 5 * ((TEMP - 2000) * (TEMP - 2000)) >> 2;

        if (TEMP < -1500) {
            OFF2 += 7 * ((TEMP + 1500) * (TEMP + 1500));
            SENS2 += (11 * ((TEMP + 1500) * (TEMP + 1500))) >> 1;
        }

        TEMP -= T2;
        OFF -= OFF2;
        SENS -= SENS2;
    }

    // Pression compensée
    int32_t P = ((((int64_t)D1 * SENS) >> 21) - OFF) >> 15;

    *temperature = TEMP / 100.0f;
    *pressure = P / 100.0f; // en mbar
}
