#include <GAUL_Drivers/Low_Level/GPIO_driver.h>
#include <GAUL_Drivers/Low_Level/SPI_driver.h>


void SPI_Enable(SPI_TypeDef *SPIx) {
    if (SPIx == SPI1) {
        RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;
        GPIO_InitPeriph(GPIOA, 2, OUT, O_PP);		// CS RFM (A2)
        GPIO_InitPeriph(GPIOA, 4, OUT, O_PP);		// CS ICM (A4)
        GPIO_InitPeriph(GPIOA, 5, ALT, AF5);		// CLK (A5)
        GPIO_InitPeriph(GPIOA, 6, ALT, AF5);		// MISO (A6)
        GPIO_InitPeriph(GPIOA, 7, ALT, AF5);		// MOSI (A7)

        GPIO_WritePin(GPIOA, 2, HIGH);
        GPIO_WritePin(GPIOA, 4, HIGH);
    } else if (SPIx == SPI4) {
        RCC->APB2ENR |= RCC_APB2ENR_SPI4EN;
        GPIO_InitPeriph(GPIOE, 4, OUT, O_PP);		// CS BARO (E4)
        GPIO_InitPeriph(GPIOE, 12, ALT, AF5);		// CLK (E12)
        GPIO_InitPeriph(GPIOE, 13, ALT, AF5);		// MISO (E13)
        GPIO_InitPeriph(GPIOE, 14, ALT, AF5);		// MOSI (E14)

        GPIO_WritePin(GPIOE, 4, HIGH);
    } else if (SPIx == SPI5) {
        RCC->APB2ENR |= RCC_APB2ENR_SPI5EN;
        GPIO_InitPeriph(GPIOB, 1, OUT, O_PP);		// CS MEM (B1)
        GPIO_InitPeriph(GPIOB, 0, ALT, AF6);		// CLK (B0)
        GPIO_InitPeriph(GPIOE, 5, ALT, AF6);		// MISO (E5)
        GPIO_InitPeriph(GPIOB, 8, ALT, AF6);		// MOSI (B8)

        GPIO_WritePin(GPIOB, 1, HIGH);
    } else return;
}

void SPI_InitPeriph(SPI_TypeDef *SPIx, unsigned short baudrate) {
	SPI_Enable(SPIx);
	SPIx->CR1 = 0;
	SPIx->CR2 = 0;
	SPIx->CR1 |= SPI_CR1_MSTR;						// Master mode
	SPIx->CR1 |= SPI_CR1_SSI;
	SPIx->CR1 |= SPI_CR1_SSM;
	SPIx->CR1 &= ~SPI_CR1_BR;        				// Clear baudrate
	SPIx->CR1 |= baudrate;            				// Set baudrate
	SPIx->CR1 &= ~(SPI_CR1_CPOL | SPI_CR1_CPHA); 	// Mode 0
	SPIx->CR1 |= SPI_CR1_SPE;						// SPI Enable
}

int8_t SPI_MOSI(SPI_TypeDef *SPIx, uint8_t *data, size_t size) {
    uint32_t timeout = TIMEOUT;
    while (size--) {
        while (!(SPIx->SR & SPI_SR_TXE)) {
            if (--timeout == 0) {
                return -1; // Timeout
            }
        }
        SPIx->DR = *data++;
    }

    timeout = TIMEOUT;
    while (SPIx->SR & SPI_SR_BSY) {
        if (--timeout == 0) {
            return -1; // Timeout
        }
    }
    (void)SPIx->DR;
    return 0;
}

int8_t SPI_MISO(SPI_TypeDef *SPIx, uint8_t *data, size_t size) {
    uint32_t timeout = TIMEOUT;
    while (size--) {
        while (!(SPIx->SR & SPI_SR_TXE)) {
            if (--timeout == 0) {
                return -1; // Timeout
            }
        }
        SPIx->DR = 0xFF; // Dummy byte

        timeout = TIMEOUT;
        while (!(SPIx->SR & SPI_SR_RXNE)) {
            if (--timeout == 0) {
                return -1; // Timeout
            }
        }
        *data++ = SPIx->DR;
    }
    return 0;
}

