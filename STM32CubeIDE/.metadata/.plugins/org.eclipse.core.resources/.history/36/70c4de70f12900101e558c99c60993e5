// Full-Duplex SPI
int8_t SPI_TransmitReceive(SPI_TypeDef *SPIx, uint8_t *pTxData, uint8_t *pRxData, size_t size, uint32_t timeout) {
    uint32_t startTick = HAL_GetTick();
    uint32_t elapsed;
    for (uint16_t i = 0; i < size; i++) {
        while (!(SPIx->SR & SPI_SR_TXE)) {
            elapsed = HAL_GetTick() - startTick;
            if (elapsed >= timeout) {
                return -1; // Timeout
            }
        }

        *(volatile uint8_t *)&SPIx->DR = pTxData[i];

        while (!(SPIx->SR & SPI_SR_RXNE)) {
            elapsed = HAL_GetTick() - startTick;
            if (elapsed >= timeout) {
                return -1; // Timeout
            }
        }

        pRxData[i] = *(volatile uint8_t *)&SPIx->DR;
    }

    while (SPIx->SR & SPI_SR_BSY) {
        elapsed = HAL_GetTick() - startTick;
        if (elapsed >= timeout) {
            return -1; // Timeout
        }
    }

    return 0;
}
