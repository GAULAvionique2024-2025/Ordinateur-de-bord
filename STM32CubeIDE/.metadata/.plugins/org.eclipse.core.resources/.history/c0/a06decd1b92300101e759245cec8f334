#ifndef INC_GAUL_DRIVERS_COMPONENTS_MS5803_H_
#define INC_GAUL_DRIVERS_COMPONENTS_MS5803_H_


#define CMD_RESET     	0x1E
#define CMD_CONVERT_D1 	0x44 //OSR->1024
#define CMD_CONVERT_D2	0x54 //OSR->1024
#define CMD_ADC_READ  	0x00
#define CMD_PROM_READ	0xA0

typedef struct {
    SPI_TypeDef 	*SPIx;
    GPIO_TypeDef 	*cs_port;
    uint8_t 		cs_pin;

    uint16_t 		calibration_values[8];

    float 			pressure_Pa;
    float 			pressure_kPa;

    float 			altitude_MSL;
    float 			altitude_m;
    float 			altitude_filtered_m;
    float 			alpha;

    float 			temp_C;
} MS5803;

uint8_t MS5803_Init(MS5803 *dev);
void MS5803_ReadTemperaturePressure(MS5803 *dev, float *temperature, float *pressure);
float MS5803_PressureToAltitude(float pressure, float sea_level_pressure);
void MS5803_Write(MS5803 *dev, uint8_t address, uint8_t value);
void MS5803_Read(MS5803 *dev, uint8_t addresse, uint8_t *rxData[], uint8_t size);


#endif /* INC_GAUL_DRIVERS_COMPONENTS_MS5803_H_ */
