static void RFM22B_Write(RFM22B *dev, uint8_t addr, uint8_t *txData, uint8_t size) {
	uint8_t tx = 0x80 | addr;
	GPIO_WritePin(dev->cs_port, dev->cs_pin, LOW);
	SPI_MISO(dev->SPIx, &tx, 1);
	SPI_MISO(dev->SPIx, txData, size);
	GPIO_WritePin(dev->cs_port, dev->cs_pin, HIGH);
}

static void RFM22B_Read(RFM22B *dev, uint8_t addr, uint8_t *rxData, uint8_t size) {
	addr &= 0x7F;
	GPIO_WritePin(dev->cs_port, dev->cs_pin, LOW);
	SPI_MOSI(dev->SPIx, &addr, 1);
	SPI_MISO(dev->SPIx, rxData, size); //vérifier qu'envoyer le rx buffer ok
	GPIO_WritePin(dev->cs_port, dev->cs_pin, HIGH);
}

static void RFM22B_ClearTX(RFM22B *dev) {
	uint8_t value = RH_RF22_FFCLRTX;
	RFM22B_Write(dev, RH_RF22_REG_08_OPERATING_MODE2, &value, 1);
}

// retourne nbr d'octets disponnibles
static uint8_t RFM22B_Available(RFM22B *dev) {
	uint8_t reg = 0;
	RFM22B_Read(dev, RH_RF22_REG_4B_RECEIVED_PACKET_LENGTH, &reg, 1);
	return reg;
}

uint8_t RFM22B_SetStandbyMode(RFM22B *dev) {
	uint8_t value = 0;
	RFM22B_Write(dev, RH_RF22_REG_07_OPERATING_MODE1, &value, 1);
	uint8_t reg;
	RFM22B_Read(dev, RH_RF22_REG_07_OPERATING_MODE1, &reg, 1);
	if(value == reg) return -1;
	return 0; // OK
}


int8_t RFM22B_Init(SPI_TypeDef *SPIx, RFM22B *dev, RFM22B_Configs *confs) {
	dev->SPIx = SPIx;
	// Reset RFM
	GPIO_WritePin(dev->snd_port, dev->snd_pin, HIGH);
	HAL_Delay(100);
	GPIO_WritePin(dev->snd_port, dev->snd_pin, LOW);
	HAL_Delay(100);

	//première lecture port SPI
	uint8_t val = 0;
	RFM22B_Read(dev, RH_RF22_REG_00_DEVICE_TYPE, &val, 1);
	if (val != 0x08) return 0; //connection non établie
	//wait for chip ready
	do {
		RFM22B_Read(dev, RH_RF22_REG_04_INTERRUPT_STATUS2, val, 1);
	}
	while (!((val & RH_RF22_ICHIPRDY) >> 1)); //check for ichiprdy (à vérifier)


	uint8_t dummy[2] = {0};
	// lire registres interrupt
	RFM22B_Read(dev, RH_RF22_REG_03_INTERRUPT_STATUS1, dummy, 2);
	uint8_t zeros[4] = {0};
	RFM22B_Write(dev, RH_RF22_REG_0B_GPIO_CONFIGURATION0, zeros, 4);
	// mettre en mode standby
	RFM22B_Write(dev, RH_RF22_REG_07_OPERATING_MODE1, tx_buffer, 2);
	// active toutes interruptions
	tx_buffer[0] = 0xFF;
	tx_buffer[1] = 0xFF;
	RFM22B_Write(dev, RH_RF22_REG_05_INTERRUPT_ENABLE1, tx_buffer, 2);
	//set thresholds registres
	tx_buffer[0] = 56; // à un packet d'overflow
	tx_buffer[1] = 0;
	tx_buffer[2] = 56;
	RFM22B_Write(dev, RH_RF22_REG_7C_TX_FIFO_CONTROL1, tx_buffer, 3);

	// écrit toutes les valeurs dans les registres
	for (int i=0; i<sizeof(confs->registers); i++) {
		tx_buffer[0] = (confs->register_settings)[i];
		RFM22B_Write(dev, (confs->registers)[i], tx_buffer, 1);
	}

	return 0; // OK
}

//transmet les bits dans tx_buffer et retourne en mode standby
int8_t RFM22B_Transmit(RFM22B *dev, uint8_t *tx_buffer, uint8_t len) {
	if (tx_buffer == NULL || len > 64) return -1;

	uint8_t ptr[] = {0};
	RFM22B_Read(dev, RH_RF22_REG_07_OPERATING_MODE1, ptr, 1);
	if (ptr[0] & RH_RF22_TXON) return -1; // already transmitting
	// send dans la FIFO et set longueur packet
	RFM22B_Write(dev, RH_RF22_REG_7F_FIFO_ACCESS, tx_buffer, len);
	ptr[0] = len;
	RFM22B_Write(dev, RH_RF22_REG_3E_PACKET_LENGTH, ptr, 1);

	// mode tx
	ptr[0] = RH_RF22_TXON;
	RFM22B_Write(dev, RH_RF22_REG_07_OPERATING_MODE1, ptr, 1);

	return 0; // OK
}

void RFM22B_SetChannel(RFM22B *dev, uint8_t channel) {
	RFM22B_Write(dev, RH_RF22_REG_79_FREQUENCY_HOPPING_CHANNEL_SELECT, &channel, 1);
}
