#include "GAUL_Drivers/Components/MS5803.h"


// Utils
static void CS_Select(MS5803 *dev) {
    GPIO_WritePin(dev->cs_port, dev->cs_pin, LOW);
}

static void CS_Deselect(MS5803 *dev) {
    GPIO_WritePin(dev->cs_port, dev->cs_pin, HIGH);
}

static void MS5803_SendCommand(MS5803 *dev, uint8_t MS5803) {
    CS_Select(dev);
    SPI_TX(dev->SPIx, &MS5803, 1);
    CS_Deselect(dev);
}

static uint32_t MS5803_ReadADC(MS5803 *dev) {
    uint8_t MS5803 = MS5803_ADC_READ;
    uint8_t rx_buf[3] = {0};

    CS_Select(dev);
    SPI_TX(dev->SPIx, &MS5803, 1);
    SPI_RX(dev->SPIx, rx_buf, 3);
    CS_Deselect(dev);

    return (rx_buf[0] << 16) | (rx_buf[1] << 8) | rx_buf[2];
}

static uint16_t MS5803_ReadPROM(MS5803 *dev, uint8_t coef) {
    uint8_t MS5803 = MS5803_PROM_READ + (coef * 2);
    uint8_t rx_buf[2] = {0};

    CS_Select(dev);
    SPI_TX(dev->SPIx, &MS5803, 1);
    SPI_RX(dev->SPIx, rx_buf, 2);
    CS_Deselect(dev);

    return (rx_buf[0] << 8) | rx_buf[1];
}

static float MS5803_PressureToAltitude(float pressure) {
    return (T0 / L) * (1 - pow((pressure / HPA_SEA_LEVEL), (R * L) / G));
}

// Functions
int8_t MS5803_Init(MS5803 *dev) {
    MS5803_SendCommand(dev, MS5803_RESET);
    HAL_Delay(5); // 2.8ms min
    for(uint8_t i = 0; i < 8; i++) {
        dev->calibration_values[i] = MS5803_ReadPROM(dev, i);
    }
    MS5803_ReadTemperaturePressure(dev);
    dev->pressure_ref = dev->pressure_Pa;
    if(dev->pressure_ref == 0) return -1;

    // Initialization EMA filter
	dev->altitude_filtered_m = 0.0f;

    return 0; // OK
}

void MS5803_ReadTemperaturePressure(MS5803 *dev) {
    uint32_t D1, D2;
    int32_t dTReference, temp;
    int64_t offset, sensibility;
    // 2e order
    int32_t T2 = 0;
    int64_t offset2 = 0, sensibility2 = 0;

    // Convert D1 (Pression)
    MS5803_SendCommand(dev, MS5803_CONVERT_D1);
    HAL_Delay(3);
    D1 = MS5803_ReadADC(dev);

    // Convert D2 (temp)
    MS5803_SendCommand(dev, MS5803_CONVERT_D2);
    HAL_Delay(3);
    D2 = MS5803_ReadADC(dev);

    dTReference = (int32_t)D2 - ((int32_t)dev->calibration_values[5] << 8);
    temp = 2000 + ((int64_t)dTReference * dev->calibration_values[6]) / (1 << 23);

    offset = ((int64_t)dev->calibration_values[2] << 16) + (((int64_t)dev->calibration_values[4] * dTReference) / (1 << 7));
    sensibility = ((int64_t)dev->calibration_values[1] << 15) + (((int64_t)dev->calibration_values[3] * dTReference) / (1 << 8));

    // Compensation (2e order)
    if(temp < 2000) {
        T2 = (dTReference * dTReference) >> 31;
        offset2 = 3 * pow((temp - 2000), 2);
        sensibility2 = 7 * ((temp - 2000) * (temp - 2000)) >> 3;
        if(temp < -1500) sensibility2 += 2 * pow((temp + 1500), 2);
    } else {
    	T2 = 0.0f;
    	offset = 0.0f;
    	sensibility2 = 0.0f;
    	if(temp >= 4500) sensibility2 -= pow((temp - 4500), 2) >> 3;
    }
    temp -= T2;
    offset -= offset2;
    sensibility -= sensibility2;

    // RESULTS
    dev->pressure_Pa = ((((int64_t)D1 * sensibility) >> 21) - offset) >> 15;
    dev->pressure_kPa = dev->pressure_Pa / 1000.0f;

    dev->temp_C = temp / 100.0f;

    // Relative altitude
	float pressure_ratio = dev->pressure_Pa / dev->pressure_ref;
	dev->altitude_m = 44330.0f * (1.0f - pow(pressure_ratio, 0.1903f));
	dev->altitude_filtered_m = ALPHA_FILTER_FACTOR * dev->altitude_m + (1 - ALPHA_FILTER_FACTOR) * dev->altitude_filtered_m; // EMA Filter

	dev->altitude_MSL = MS5803_PressureToAltitude(dev->pressure_Pa / 100.0f);
}
