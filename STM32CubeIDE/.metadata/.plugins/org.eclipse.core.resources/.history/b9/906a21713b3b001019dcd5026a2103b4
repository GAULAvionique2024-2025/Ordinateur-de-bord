#ifndef INC_GAUL_DRIVERS_COMPONENTS_RFM22B_H_
#define INC_GAUL_DRIVERS_COMPONENTS_RFM22B_H_

#include "stm32f4xx.h"
#include "math.h"
#include "GAUL_Drivers/Low_Level/SPI_driver.h"
#include "GAUL_Drivers/Low_Level/GPIO_driver.h"

#define XTAL_FREQ 30000000UL // 30 MHz crystal

typedef struct {
	SPI_TypeDef		*SPIx;
	GPIO_TypeDef 	*cs_port;
	uint8_t      	cs_pin;

	uint8_t      	int_pin;
	GPIO_TypeDef 	*int_port;

	uint32_t		frequency;
	uint64_t			*data;
} RFM22B;

void RFM22B_Init(SPI_TypeDef *SPIx, RFM22B *dev, uint32_t freq_hz);
void RFM22B_Transmit(RFM22B *dev, uint8_t *data, uint8_t len);
uint8_t RFM22B_Receive(RFM22B *dev);


#endif /* INC_GAUL_DRIVERS_COMPONENTS_RFM22B_H_ */
