#include "GAUL_Drivers/Communications/SPI_driver.h"
#include "GAUL_Drivers/Communications/GPIO_driver.h"


void SPI_Enable(SPI_TypeDef *SPIx) {
    if (SPIx == SPI1) {
        RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;
        GPIO_Initialisation(GPIOA, 2, OUT, O_PP);	// CS (A2)
        GPIO_Initialisation(GPIOA, 5, ALT, );		// CLK (A5)
        GPIO_Initialisation(GPIOA, 6, ALT, );		// MISO (A6)
        GPIO_Initialisation(GPIOA, 7, ALT, );		// MOSI (A7)

        //GPIO_WritePin(GPIOA, 2, HIGH); // Active LOW
    } else if (SPIx == SPI2) {
        //RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;
        GPIO_Initialisation(GPIOA, 2, OUT, O_PP);	// CS (A)
        GPIO_Initialisation(GPIOA, 5, ALT, );		// CLK
        GPIO_Initialisation(GPIOA, 6, ALT, );		// MISO
        GPIO_Initialisation(GPIOA, 7, ALT, );		// MOSI

        //GPIO_WritePin(GPIOA, 2, HIGH); // Active LOW
    } else if (SPIx == SPI3) {
        //RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;
        GPIO_Initialisation(GPIOA, 2, OUT, O_PP);	// CS
        GPIO_Initialisation(GPIOA, 5, ALT, );		// CLK
        GPIO_Initialisation(GPIOA, 6, ALT, );		// MISO
        GPIO_Initialisation(GPIOA, 7, ALT, );		// MOSI

        //GPIO_WritePin(GPIOA, 2, HIGH); // Active LOW
    } else if (SPIx == SPI4) {
        //RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;
        GPIO_Initialisation(GPIOA, 2, OUT, O_PP);	// CS
        GPIO_Initialisation(GPIOA, 5, ALT, );		// CLK
        GPIO_Initialisation(GPIOA, 6, ALT, );		// MISO
        GPIO_Initialisation(GPIOA, 7, ALT, );		// MOSI

        //GPIO_WritePin(GPIOA, 2, HIGH); // Active LOW
    } else if (SPIx == SPI5) {
        //RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;
        GPIO_Initialisation(GPIOA, 2, OUT, O_PP);	// CS
        GPIO_Initialisation(GPIOA, 5, ALT, );		// CLK
        GPIO_Initialisation(GPIOA, 6, ALT, );		// MISO
        GPIO_Initialisation(GPIOA, 7, ALT, );		// MOSI

        //GPIO_WritePin(GPIOA, 2, HIGH); // Active LOW
    } else return;
}

void SPI_Initialisation(SPI_TypeDef *SPIx) {
	if(SPIx != SPI2 || SPIx != SPI3) SPI_Enable(SPIx); // Protection
	SPI5->CR1 |= SPI_CR1_MSTR; // Master configuration
	SPI5->CR1 |= SPI_CR1_SSI;
	SPI5->CR1 |= SPI_CR1_SSM;
	SPI5->CR1 |= SPI_CR1_SPE; // SPI Enable
}

void SPI_Transmit(uint8_t* data, size_t size) {

	while(size--) {
		SPI5->DR = *data++;

		while(!(SPI5->SR & SPI_SR_TXE)) {}
	}
}
