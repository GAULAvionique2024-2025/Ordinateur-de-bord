#ifndef INC_GAUL_DRIVERS_COMMUNICATIONS_SPI_DRIVER_H_
#define INC_GAUL_DRIVERS_COMMUNICATIONS_SPI_DRIVER_H_

#include "stm32f4xx_hal.h"

#define BAUDRATE_2     (0x0U << 3)  // 000: fPCLK/2
#define BAUDRATE_4     (0x1U << 3)  // 001: fPCLK/4
#define BAUDRATE_8     (0x2U << 3)  // 010: fPCLK/8
#define BAUDRATE_16    (0x3U << 3)  // 011: fPCLK/16
#define BAUDRATE_32    (0x4U << 3)  // 100: fPCLK/32
#define BAUDRATE_64    (0x5U << 3)  // 101: fPCLK/64
#define BAUDRATE_128   (0x6U << 3)  // 110: fPCLK/128
#define BAUDRATE_256   (0x7U << 3)  // 111: fPCLK/256

void SPI_InitPeriph(SPI_TypeDef *SPIx, unsigned short baudrate);

int8_t SPI_TX(SPI_TypeDef *SPIx, uint8_t *data, size_t size);
int8_t SPI_RX(SPI_TypeDef *SPIx, uint8_t *data, size_t size);
int8_t SPI_TransmitReceive(SPI_TypeDef *SPIx, uint8_t *data, size_t size);

