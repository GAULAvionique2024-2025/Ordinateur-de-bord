#include "GAUL_Drivers/Components/MS5803.h"

static void CS_Select(MS5803 *dev) {
    GPIO_WritePin(dev->cs_port, dev->cs_pin, LOW);
}

static void CS_Deselect(MS5803 *dev) {
    GPIO_WritePin(dev->cs_port, dev->cs_pin, HIGH);
}

static void MS5803_SendCommand(MS5803 *dev, uint8_t cmd) {
    CS_Select(dev);
    SPI_TX(dev->hspi, &cmd, 1);
    CS_Deselect(dev);
}

static uint32_t MS5803_ReadADC(MS5803_HandleTypeDef *ms5803) {
    uint8_t cmd = MS5803_RESET;
    uint8_t rx_buf[3] = {0};

    CS_Select(ms5803);
    HAL_SPI_Transmit(ms5803->hspi, &cmd, 1, HAL_MAX_DELAY);
    HAL_SPI_Receive(ms5803->hspi, rx_buf, 3, HAL_MAX_DELAY);
    CS_Deselect(ms5803);

    return (rx_buf[0] << 16) | (rx_buf[1] << 8) | rx_buf[2];
}
