#include "GAUL_Drivers/Communications/SPI_driver.h"
#include "GAUL_Drivers/Communications/GPIO_driver.h"


void SPI_Enable(SPI_TypeDef *SPIx) {
    if (SPIx == SPI1) {
        RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;
        GPIO_Initialisation(GPIOA, 4, OUT50, O_GP_PP); // CS
        GPIO_Initialisation(GPIOA, 5, OUT50, O_AF_PP); // CLK
        GPIO_Initialisation(GPIOA, 6, IN, I_PP);    // MISO SPI1
        GPIO_Initialisation(GPIOA, 7, OUT50, O_AF_PP); // MOSI SPI1

        GPIO_WritePin(GPIOA, 4, HIGH);

        SPI1->CR1 = SPI_CR1_MSTR | SPI_CR1_BR_1 | SPI_CR1_BR_2 | SPI_CR1_SSM | SPI_CR1_SSI | SPI_CR1_SPE;
    } else if (SPIx == SPI2) {
        RCC->APB1ENR |= RCC_APB1ENR_SPI2EN;

        GPIO_Initialisation(GPIOB, 13, OUT50, O_AF_PP); // CLK
        GPIO_Initialisation(GPIOB, 14, IN, I_PP);    // MISO SPI2
        GPIO_Initialisation(GPIOB, 15, OUT50, O_AF_PP); // MOSI SPI2

        SPI2->CR1 = SPI_CR1_MSTR | SPI_CR1_BR_1 | SPI_CR1_BR_2 | SPI_CR1_SSM | SPI_CR1_SSI | SPI_CR1_SPE;
    }
}

void SPI_Initialisation(SPI_TypeDef *SPIx) {
	SPI_Enable(SPIx);
	RCC->APB2ENR |= RCC_APB2ENR_SPI5EN;

	SPI5->CR1 |= SPI_CR1_MSTR; //Master configuration
	SPI5->CR1 |= SPI_CR1_SSI;
	SPI5->CR1 |= SPI_CR1_SSM;
	SPI5->CR1 |= SPI_CR1_SPE; //SPI Enable
}

void SPI_Transmit(uint8_t* data, size_t size) {

	while(size--) {
		SPI5->DR = *data++;

		while(!(SPI5->SR & SPI_SR_TXE)) {}
	}
}
