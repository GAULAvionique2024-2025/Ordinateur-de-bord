#include "GAUL_Drivers/Communications/USART_driver.h"
#include "GAUL_Drivers/Communications/GPIO_driver.h"


void USART_Enable_Clock(USART_TypeDef *USARTx) {
	if (USARTx == USART1) {
		RCC->APB2ENR |= RCC_APB2ENR_USART1EN; // Enable USART1 clock
		GPIO_Init(GPIOA, 9, ALT, AF7); // TX (A9)
		GPIO_Init(GPIOA, 10, ALT, AF7); // RX (A10)
	} else if (USARTx == USART2) {
		RCC->APB1ENR |= RCC_APB1ENR_USART2EN; // Enable USART2 clock
		GPIO_Init(GPIOD, 5, ALT, AF7); // TX (D5)
		GPIO_Init(GPIOD, 6, ALT, AF7); // RX (D6)
	} else if (USARTx == USART3) {
		RCC->APB1ENR |= RCC_APB1ENR_USART3EN; // Enable USART3 clock
		GPIO_Init(GPIOB, 10, ALT, AF7); // TX (B10)
		GPIO_Init(GPIOB, 11, ALT, AF7); // RX (B11)
	} else if (USARTx == USART6) {
		RCC->APB2ENR |= RCC_APB2ENR_USART6EN; // Enable USART6 clock
		GPIO_Init(GPIOC, 6, ALT, AF8); // TX (C6)
		GPIO_Init(GPIOC, 7, ALT, AF8); // RX (C7)
	}
}

uint32_t USART_CalculateBRR(USART_TypeDef *USARTx, uint32_t baudrate) {
    uint32_t pclk;
    if (USARTx == USART1 || USARTx == USART6)
        pclk = HAL_RCC_GetPCLK2Freq(); // APB2
    else
        pclk = HAL_RCC_GetPCLK1Freq(); // APB1

    float usartdiv = (float)pclk / (16.0f * baudrate);
    uint32_t mantissa = (uint32_t)usartdiv;
    uint32_t fraction = (uint32_t)((usartdiv - mantissa) * 16.0f + 0.5f);

    if (fraction > 15) {
        mantissa += 1;
        fraction = 0;
    }

    return (mantissa << 4) | (fraction & 0xF);
}

void USART_Init(USART_TypeDef *USARTx, uint16_t baudrate) {
	USART_Enable_Clock(USARTx);
	USARTx->BRR = (0x9 << 4) | 0xC; // Baudrate
	USARTx->CR1 |= USART_CR1_OVER8;
	USARTx->CR1 &= ~USART_CR1_M; // 8 bits
	USARTx->CR1 &= ~USART_CR1_PCE; // Disable parity
	USARTx->CR2 &= ~USART_CR2_STOP; // 1 stop bit
	USARTx->CR1 |= USART_CR1_RE; // RX Enable
	USARTx->CR1 |= USART_CR1_TE; // TX Enable
	USARTx->CR1 |= USART_CR1_UE;
}

//TODO: timeout maybe not necessary + add interrupt
int8_t USART_TX(USART_TypeDef *USARTx, uint8_t *data, uint16_t size) {
    uint32_t timeout;
	while(size--) {
		timeout = TIMEOUT;
		while (!(USARTx->SR & USART_SR_TXE)) {
			if (--timeout == 0) {
				return -1;
			}
		}
		USARTx->DR = *data++;
	}

	timeout = TIMEOUT;
	while (!(USARTx->SR & USART_SR_TC)) {
		if (--timeout == 0) {
			return -1;
		}
	}

	return 0;
}

//TODO: add interrupt + circular buffer
int8_t USART_RX(USART_TypeDef *USARTx, uint8_t *data, uint16_t size) {
	uint32_t timeout;
	while(size--) {
		timeout = TIMEOUT;
		while (!(USARTx->SR & USART_SR_RXNE)) {
			if (--timeout == 0) {
				return -1;
			}
		}
		*data++ = USARTx->DR;
	}

	return 0;
}
