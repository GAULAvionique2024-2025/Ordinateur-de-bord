#include "GAUL_Drivers/Communications/GPIO_driver.h"

void Enable_GPIO_Clock(GPIO_TypeDef *port) {
    if (port == GPIOA) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN; // Activate PORT A
    } else if (port == GPIOB) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN; // Activate PORT B
    } else if (port == GPIOC) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN; // Activate PORT C
    } else if (port == GPIOD) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIODEN; // Activate PORT D
    } else if (port == GPIOE) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOEEN; // Activate PORT E
    } else if (port == GPIOF) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOFEN; // Activate PORT F
    } else if (port == GPIOG) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOGEN; // Activate PORT G
    } else if (port == GPIOH) {
        RCC->AHB1ENR |= RCC_AHB1ENR_GPIOHEN; // Activate PORT H
    }
}

void Init_GPIO(GPIO_TypeDef *GPIOx, unsigned short pin, unsigned short dir, unsigned short opt) {
    Enable_GPIO_Clock(GPIOx);

    // Pin configuration

}

int Read_GPIO(GPIO_TypeDef *GPIOx, unsigned short pin) {
    return (GPIOx->IDR & (1 << pin)) >> pin;
}

void Write_GPIO(GPIO_TypeDef *GPIOx, unsigned short pin, unsigned short state) {
    if (state) {
    	GPIOx->ODR |= (1 << pin);
    } else {
    	GPIOx->ODR &= ~(1 << pin);
    }
}

void Toggle_GPIO(GPIO_TypeDef *GPIOx, unsigned short pin) {
	GPIOx->ODR ^= (1 << pin);
}
