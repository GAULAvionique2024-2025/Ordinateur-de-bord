	(text "ANT_DETECT, ANT_OFF, ANT_SHORT_N : gestion avancée d'antenne non utilisée.\nGEOFENCE_STAT, RTK_STAT : sorties de statut inutiles.\nRXD2, TXD2 : second UART réservé aux corrections, non requis avec un seul UART hôte.\nV_BCKP : pas de besoin de pile de bck pour le RTC. \nUSB, SDA, SCL : interfaces non exploitées.\nD_SEL : laissé flottant pour conserver l'UART actif.\nnRESET : Réinitialise le module GNSS.\nTIMEPULSE : sync 1Hz, voir fix actif, pas pour materiel.\n\nTX_READY : Indique buffer transmission prêt\nEXTINT : Entrée événement (interrupt)"
		(exclude_from_sim no)
		(at 16.256 41.148 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "b8466200-a05e-4f46-9121-db19772e48f6")
	)
	(text "Longueur d'onde antenne\n~19 cm (L1), ~24 cm (L2), ~25,5 cm (L5)."
