	(text "Power good protection, block the ignition if the power is not above 5.06v\nif V_{in} > 5.06 = Power good\n\nV_{ref} = ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/a7ab30b6-1c68-4176-964a-109ef5b035cc:VALUE} * ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/0614f46a-a67b-4246-947a-398bbcc78170:VALUE} / (${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/0f2812a9-637d-4404-af99-83782ba39a65:VALUE} + ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/0614f46a-a67b-4246-947a-398bbcc78170:VALUE}) = 0.66v\nif V_{in} = 5.06 * ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/92df379c-8a9d-4d9f-9702-735544800e14:VALUE} / (${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/5b502a14-d9e3-41e2-90ff-41e203b68768:VALUE} + ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/92df379c-8a9d-4d9f-9702-735544800e14:VALUE}) = 0.66v\n"
		(exclude_from_sim no)
		(at 16.764 84.582 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1e5adcb7-cbe8-4b8b-a776-6c7efca4305b")
	)
