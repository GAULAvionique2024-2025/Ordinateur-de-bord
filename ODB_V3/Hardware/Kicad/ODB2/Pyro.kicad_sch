	)
	(text "Power good protection, block the ignition if the power is not above 5.06v\nif V_{in} > 5.06 = Power good\n\nV_{ref} = ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/a7ab30b6-1c68-4176-964a-109ef5b035cc:VALUE} * ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/0614f46a-a67b-4246-947a-398bbcc78170:VALUE} / (${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/0f2812a9-637d-4404-af99-83782ba39a65:VALUE} + ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/0614f46a-a67b-4246-947a-398bbcc78170:VALUE}) = 0.66v\nif V_{in} = 5.06 * ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/92df379c-8a9d-4d9f-9702-735544800e14:VALUE} / (${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/5b502a14-d9e3-41e2-90ff-41e203b68768:VALUE} + ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/92df379c-8a9d-4d9f-9702-735544800e14:VALUE}) = 0.66v\n"
		(exclude_from_sim no)
		(at 16.764 84.582 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1e5adcb7-cbe8-4b8b-a776-6c7efca4305b")
	)
	(text "Pyro 4"
		(exclude_from_sim no)
		(at 84.074 149.606 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.8)
				(bold yes)
			)
			(justify left)
		)
		(uuid "35d9e014-7e2c-445b-826d-ad2c8f8a7bb4")
	)
	(text "${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/adc6630a-148c-4b6e-b308-9cb2acd234f0:REFERENCE}, ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/6232a2e0-926a-4e4d-a9df-85a8a2c9a99e:REFERENCE} are there to clamp the line to ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/a7ab30b6-1c68-4176-964a-109ef5b035cc:VALUE}\n\nThe voltage divider form by ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/1fc7b8cd-8707-4b65-a4c3-5357653aeaad:REFERENCE} and ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/2e3093ad-5b8b-4ec8-88b6-78ab2fbcc977:REFERENCE} are there \nto lower V_{in} to be safe for the stm\n\nIf V_{in} = 24v (Max value)\n24 * ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/2e3093ad-5b8b-4ec8-88b6-78ab2fbcc977:VALUE} / (${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/1fc7b8cd-8707-4b65-a4c3-5357653aeaad:VALUE} + ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/2e3093ad-5b8b-4ec8-88b6-78ab2fbcc977:VALUE}) = 3.13v\n\nWith ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/2e3093ad-5b8b-4ec8-88b6-78ab2fbcc977:REFERENCE} and ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/1fc7b8cd-8707-4b65-a4c3-5357653aeaad:REFERENCE} the total resistance is\n${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/2e3093ad-5b8b-4ec8-88b6-78ab2fbcc977:VALUE} + ${/4b06c5d1-aa8b-48ed-8972-b43a60cfab78/8ab7427e-7183-4caa-ac8a-08b0bd412372/1fc7b8cd-8707-4b65-a4c3-5357653aeaad:VALUE} = 207k\nWith this resistance and V_{in} = 24v we get 24v/207k = 0.116mA\nThe igniter we use is J-Tek Igniter.\nThe maximum test current is 40mA\n0.116mA < 40mA = We are good"
		(exclude_from_sim no)
		(at 217.17 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8cb48aa4-b014-4d67-ad72-53666899ed30")
	)
