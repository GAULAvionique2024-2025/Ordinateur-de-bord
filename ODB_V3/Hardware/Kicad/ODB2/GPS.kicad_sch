	(text "7 pins (min) breakout board\nVCC, GND, USART(TX/RX), TX_READY,\nnRESET, ZED_EXTIN"
		(exclude_from_sim no)
		(at 15.494 94.234 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "2379a467-6cec-4b4b-9ca1-5fe7bf8efd67")
	)
	(text "ANT_DETECT, ANT_OFF, ANT_SHORT_N : gestion \navancée d'antenne non utilisée.\nGEOFENCE_STAT, RTK_STAT : sorties de statut\ninutiles.\nRXD2, TXD2 : second UART réservé aux \ncorrections, non requis avec un seul UART hôte.\nV_BCKP : pas de besoin de pile de bck pour\nle RTC. \nUSB, SDA, SCL : interfaces non exploitées.\nD_SEL : laissé flottant pour conserver\nl'UART actif.\nnRESET : Réinitialise le module GNSS.\nTIMEPULSE : sync 1Hz, voir fix actif,\npas pour materiel.\n\nTX_READY : Indique buffer transmission prêt\nEXTINT : Entrée événement (interrupt)"
		(exclude_from_sim no)
		(at 15.24 76.2 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "32fb5e52-f66a-4640-abe3-a1492d75e3be")
	)
