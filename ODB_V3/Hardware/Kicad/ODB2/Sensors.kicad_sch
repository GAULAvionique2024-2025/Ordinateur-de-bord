	)
	(text "ANT_DETECT, ANT_OFF, ANT_SHORT_N : gestion \navancée d'antenne non utilisée.\nGEOFENCE_STAT, RTK_STAT : sorties de statut\ninutiles.\nRXD2, TXD2 : second UART réservé aux \ncorrections, non requis avec un seul UART hôte.\nV_BCKP : pas de besoin de pile de bck pour\nle RTC. \nUSB, SDA, SCL : interfaces non exploitées.\nD_SEL : laissé flottant pour conserver\nl'UART actif.\nTIMEPULSE : sync 1Hz, voir fix actif,\npas pour materiel\n\nnRESET : Réinitialise le module GNSS\nTX_READY : Indique buffer transmission prêt\nEXTINT : Entrée événement (interrupt)"
		(exclude_from_sim no)
		(at 193.04 69.85 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "900026d3-8759-4e95-b245-aadf56107cd1")
	)
	(text "Sensors"
